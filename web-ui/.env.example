# ===== n8n Webhook =====
# URL webhook n8n di Railway (setelah deploy)
# Contoh: https://seo-engine.up.railway.app/webhook/seo-content-engine
N8N_WEBHOOK_URL=https://YOUR_N8N_RAILWAY_URL/webhook/seo-content-engine

# Secret untuk validasi request dari UI ke n8n (isi bebas, sama di n8n juga)
WEBHOOK_SECRET=ganti-dengan-string-rahasia-acak

# ===== Basic Auth (proteksi akses UI) =====
# Kalau dua-duanya kosong, auth dinonaktifkan (untuk local dev)
# Untuk production di Vercel, WAJIB diisi.
UI_USERNAME=admin
UI_PASSWORD=ganti-dengan-password-kuat
